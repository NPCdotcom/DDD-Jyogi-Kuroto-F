# EditorConfig: https://editorconfig.org
# Google Java Style Guide 準拠 (docs/CommonSense.md)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_style = space
indent_size = 2
max_line_length = 100
continuation_indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{gradle,gradle.kts}]
indent_size = 4

[*.{xml,html}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{properties,sh}]
indent_size = 2

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
